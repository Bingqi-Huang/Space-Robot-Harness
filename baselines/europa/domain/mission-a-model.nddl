// Mission A domain for the EUROPA->PLEXIL machinery (execution_plan §11.2, §21.6): "PDU-2 reported a fault:
// restore it, verify, return the rover to the dock with the arm stowed." Base/Posture/Jaws timelines and their
// navigate/dock/arm_ready/stow rules are the same ones `mission-b-model.nddl` already has and already validated
// live (F105) -- duplicated here, not shared, a deliberate short-term trade-off (todo.md: consolidate into one
// frozen capability model before the artifact freeze, not before). `Unit`/`Panel` and `press` are new.

class Location
{
  string name;
  Location(string _name) { name = _name; }
}

class NamedPose extends Location
{
  NamedPose(string _name) { super(_name); }
}

class Feature
{
  string name;
  Location approach;
  Location work;
  Feature(string _name, Location _approach, Location _work)
  {
    name = _name;
    approach = _approach;
    work = _work;
  }
}

class Base extends Timeline
{
  predicate At { Location loc; }
  predicate Moving { Location to; }
}

class Posture extends Timeline
{
  predicate Stowed {}
  predicate Ready {}
}

// no pick/place in this domain -- Jaws exists only so `stow`'s own precondition (a held item must not be folded
// through the rover, openral_ext/capability_server/node.py) can be stated; nothing here ever changes it.
class Jaws extends Timeline
{
  predicate Empty {}
  predicate Holding {}
}

// the serviced unit's status lamp/reset button, reported faulted at mission start
class Panel extends Timeline
{
  predicate Faulted {}
  predicate Restored {}
}

class Unit
{
  string name;
  Panel panel;
  Feature button;  // which surveyed feature presses this unit's reset -- a structural fact, like a Feature's own stances
  Unit(string _name, Feature _button) { name = _name; panel = new Panel(); button = _button; }
}

class LunarBot
{
  Base base;
  Posture posture;
  Jaws jaws;
  LunarBot() { base = new Base(); posture = new Posture(); jaws = new Jaws(); }

  action navigate_to_feature { Feature feature; float standoff_m; eq(standoff_m, 1.5); leq(duration, 400); }
  action dock_at_feature { Feature feature; float standoff_m; eq(standoff_m, 0.0); leq(duration, 240); }
  action navigate_to_pose { NamedPose pose; leq(duration, 400); }
  action stow { float tolerance_rad; eq(tolerance_rad, 0.08); leq(duration, 120); }
  // press's own contract needs no particular starting posture ("plans its own way from wherever the arm is") and
  // does not itself need arm_ready -- but it does reach into the panel to press the button and does not fold back
  // to the travel posture afterward (openral_ext/capability_server/contracts.yaml: "the tool goes in ... then
  // withdraws", not "returns to stowed"), so it transitions posture from Stowed (this covered instance's own
  // starting posture, not a general requirement) to Ready, which is what leaves `stow` something real to do.
  action press { Unit unit; Feature feature; leq(duration, 420); }
}

LunarBot::navigate_to_feature
{
  met_by(condition object.base.At from);
  equals(effect object.base.Moving m);
  eq(m.to, feature.approach);
  meets(effect object.base.At to);
  eq(to.loc, feature.approach);
}

LunarBot::dock_at_feature
{
  met_by(condition object.base.At from);
  eq(from.loc, feature.approach);
  equals(effect object.base.Moving m);
  eq(m.to, feature.work);
  meets(effect object.base.At to);
  eq(to.loc, feature.work);
}

LunarBot::navigate_to_pose
{
  met_by(condition object.base.At from);
  equals(effect object.base.Moving m);
  eq(m.to, pose);
  meets(effect object.base.At to);
  eq(to.loc, pose);
}

LunarBot::stow
{
  met_by(condition object.posture.Ready from);
  contained_by(condition object.jaws.Empty j);
  meets(effect object.posture.Stowed to);
}

LunarBot::press
{
  // `feature` is kept as its own action parameter (not just read off unit.button) so it is directly readable in
  // the activity's own parameter list, the same reason pick/place keep `support` alongside `item` -- constrained
  // to actually be the unit's own button, not left for the solver to pick freely.
  eq(feature, unit.button);
  contained_by(condition object.base.At bp);
  eq(bp.loc, feature.work);
  met_by(condition object.posture.Stowed from);
  meets(effect object.posture.Ready to);
  met_by(condition unit.panel.Faulted pf);
  meets(effect unit.panel.Restored pt);
}
