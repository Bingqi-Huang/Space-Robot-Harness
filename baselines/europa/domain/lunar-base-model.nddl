// The one frozen domain of the EUROPA->PLEXIL baseline, for both missions (execution_plan §11.2, §21.6;
// docs/baselines/authoring_spec.md, locked 2026-09-23): the rover's base, arm posture and jaws, every inventoried item's
// location, every serviced unit's panel, and the capabilities that change them -- navigate_to_feature,
// dock_at_feature, navigate_to_pose, arm_ready, stow, pick, place, press. Mission A ("every unit restored, arm stowed,
// rover at dock") and Mission B ("item X from S on D, arm stowed, rover at dock") differ only in their goals, and each
// has pick/place and press available.
//
// Re-authored after the freeze for held-out case L4 (docs/reauthoring/cases/l4.md; tier 3 lifted for it): a unit whose
// bay holds a module that is not serviceable is Blocked -- its reset cannot close it until a serviceable module of the
// kind the bay takes is installed; the failed module comes out and is set aside on a free place point; a serviceable
// module may be taken out of an energized unit only if its load is non-critical and with mission control's authorization
// (flight rule, 14 CFR 1214.403), which de-energizes that unit. Bays, their modules and their access are new objects
// and timelines; remove_module / take_donor_module / install_module / deposit_module are the pick / place capabilities
// in those roles, request_authorization is a request to mission control.
//
// An activity's parameters are the capability's arguments (host.py's capability_call, see docs/baselines/europa.md's
// traceability table); a parameter with no reason to vary in this domain is pinned with `eq` at its contract default.
// Durations are bounded by the contracts' `default_deadline_s`.

class Location
{
  string name;
  Location(string _name) { name = _name; }
}

// the named planar poses of the site map (the dock)
class NamedPose extends Location
{
  NamedPose(string _name) { super(_name); }
}

// a surveyed site interaction point and the two base stances the contracts define for it
class Feature
{
  string name;
  Location approach;  // navigate_to_feature: standoff_m out along the normal
  Location work;      // dock_at_feature, standoff 0: the arm reaches the feature
  Feature(string _name, Location _approach, Location _work)
  {
    name = _name;
    approach = _approach;
    work = _work;
  }
}

class Base extends Timeline
{
  predicate At { Location loc; }
  predicate Moving { Location to; }
}

// where a movable item is: on a surveyed support, or in the rover's own jaws. `pick`/`place` are the only
// activities that move it -- nothing else changes an item's location in this domain.
class ItemLoc extends Timeline
{
  predicate On { Feature support; }
  predicate Held {}
}

// every item of the inventory record (manifest), by serial number, on its recorded support (an item recorded in a unit's
// bay is that bay's module, see Bay). `kind` is its equipment-catalogue name; `serviceable` is false for an item the
// record lists out of service and for the module whose unit reports a failed self-test (power_status trip cause
// ORU_SELFTEST_FAIL).
class Item
{
  string name;
  string kind;
  bool serviceable;
  ItemLoc loc;
  Item(string _name, string _kind, bool _serviceable) { name = _name; kind = _kind; serviceable = _serviceable; loc = new ItemLoc(); }
}

// a surveyed place point (site_map type `place`) that is not a unit's equipment bay: where pick, place and
// deposit_module work. `free`: nothing stands on it in the inventory record.
class Place extends Feature
{
  bool free;
  Place(string _name, Location _approach, Location _work, bool _free) { super(_name, _approach, _work); free = _free; }
}

// arm_ready/stow move the arm between its two named postures; pick/place need Ready and change Jaws/ItemLoc
// together. Neither posture nor jaws models the arm's continuous motion -- contracts.yaml's own capabilities are
// single, whole-operation calls (§4.2), not a joint-space trajectory the domain has any reason to plan over.
class Posture extends Timeline
{
  predicate Stowed {}
  predicate Ready {}
}

// HoldingModule: a module taken out of a unit's bay (remove_module / take_donor_module), which only install_module or
// deposit_module put down -- kept apart from a picked item so that neither pick nor place is planned for a bay's module
class Jaws extends Timeline
{
  predicate Empty {}
  predicate Holding { Item item; }
  predicate HoldingModule { Item module; }
}

// a serviced unit's breaker as its own telemetry reports it (power_status): tripped = Faulted, closed and energized =
// Restored; tripped (or de-energized) with a bay that reports no module or one that is not serviceable = Blocked
class Panel extends Timeline
{
  predicate Faulted {}
  predicate Restored {}
  predicate Blocked {}
}

class Unit
{
  string name;
  Panel panel;
  Feature button;  // which surveyed feature presses this unit's reset -- a structural fact, like a Feature's own stances
  bool noncritical;  // the load it feeds is non-critical (power_status criticality)
  Unit(string _name, Feature _button, bool _noncritical) { name = _name; panel = new Panel(); button = _button; noncritical = _noncritical; }
}

// the flight rule on a bay (14 CFR 1214.403): its module may be taken out of an energized unit only with mission
// control's authorization -- Reserved while the unit is energized and no authorization is on record, else Cleared
class Access extends Timeline
{
  predicate Reserved {}
  predicate Cleared {}
}

// the module in a unit's bay (power_status installed_modules; the inventory record)
class Contents extends Timeline
{
  predicate Holds { Item module; }
  predicate Empty {}
}

// a unit's equipment bay (site_map: a place point with role equipment_bay and its unit). Not a `Place`: its module comes
// out and goes in only as the unit's module (remove_module, take_donor_module, install_module).
class Bay extends Feature
{
  Unit unit;
  string takes;  // the catalogue kind of module it holds (the one the inventory record has in it)
  Access access;
  Contents contents;
  Bay(string _name, Location _approach, Location _work, Unit _unit, string _takes)
  {
    super(_name, _approach, _work);
    unit = _unit;
    takes = _takes;
    access = new Access();
    contents = new Contents();
  }
}

class LunarBot
{
  Base base;
  Posture posture;
  Jaws jaws;
  LunarBot() { base = new Base(); posture = new Posture(); jaws = new Jaws(); }

  action navigate_to_feature { Feature feature; float standoff_m; eq(standoff_m, 1.2); leq(duration, 400); }
  action dock_at_feature { Feature feature; float standoff_m; eq(standoff_m, 0.0); leq(duration, 240); }
  action navigate_to_pose { NamedPose pose; leq(duration, 400); }
  action arm_ready { float tolerance_rad; eq(tolerance_rad, 0.08); leq(duration, 120); }
  action stow { float tolerance_rad; eq(tolerance_rad, 0.08); leq(duration, 120); }
  // pick's contract does not itself require Ready (it plans its own way from wherever the arm is); Ready is
  // required here because that is the covered instance's own verified order (Ours' and PLEXIL's covered calls,
  // research repo F92-F100, F104), not an unverified shortcut the solver would otherwise be free to take.
  // target/part (pick) and release_constraint (place) are natural-language/catalogue text the solver has no reason
  // to reason over (there is exactly one way to describe an item); host.py's capability_call fills them in from
  // the baselines' shared item table (baselines/item_descriptions.json).
  action pick { Item item; Place support; leq(duration, 900); }
  action place { Item item; Place support; leq(duration, 600); }
  // a unit's module out of / into its bay and a removed module set down: the pick / place capabilities (host.py's
  // capability_call), with what they do to the unit. `unit` is kept as a parameter, constrained to be the bay's own,
  // like press's `feature`. They start after the state they are planned from (t = 0).
  action remove_module { Item item; Bay bay; Unit unit; leq(1, start); leq(duration, 900); }
  action take_donor_module { Item item; Bay bay; Unit unit; leq(1, start); leq(duration, 900); }
  action install_module { Item item; Bay bay; Unit unit; leq(1, start); leq(duration, 600); }
  action deposit_module { Item item; Place support; leq(1, start); leq(duration, 600); }
  // mission control's authorization to take a bay's module out of its energized unit: a request on the operator channel
  // (kind authorization, the held pick on the bay), decided 300 s of mission time after it arrives plus the one-way link
  // delay each way (experiments/operator_console/console.py); host.py sends it, not PLEXIL
  action request_authorization { Bay bay; Unit unit; leq(1, start); leq(duration, 320); }
  // press's own contract needs no particular starting posture ("plans its own way from wherever the arm is") and
  // does not itself need arm_ready -- but it does reach into the panel to press the button and does not fold back
  // to the travel posture afterward (contracts.yaml: "the tool goes in ... then withdraws", not "returns to
  // stowed"), so it ends in Ready, which is what leaves `stow` something real to do. (Re-authoring L4: it no longer
  // requires Stowed before -- the contract does not, and a press right after installing a module starts from Ready.)
  action press { Unit unit; Feature feature; leq(duration, 420); }
}

// Nav2 drives from wherever the base is
LunarBot::navigate_to_feature
{
  met_by(condition object.base.At from);
  equals(effect object.base.Moving m);
  eq(m.to, feature.approach);
  meets(effect object.base.At to);
  eq(to.loc, feature.approach);
}

// contract: closes the last metre onto the work pose, entered along the feature's axis -- from its approach point
LunarBot::dock_at_feature
{
  met_by(condition object.base.At from);
  eq(from.loc, feature.approach);
  equals(effect object.base.Moving m);
  eq(m.to, feature.work);
  meets(effect object.base.At to);
  eq(to.loc, feature.work);
}

LunarBot::navigate_to_pose
{
  met_by(condition object.base.At from);
  equals(effect object.base.Moving m);
  eq(m.to, pose);
  meets(effect object.base.At to);
  eq(to.loc, pose);
}

LunarBot::arm_ready
{
  met_by(condition object.posture.Stowed from);
  meets(effect object.posture.Ready to);
}

// stow's own contract refuses a load in the jaws (openral_ext/capability_server/node.py: folding a held item
// through the rover is a hardware limit, not a task rule) -- the domain states the same refusal as a precondition.
// `contained_by`, not `met_by`, for jaws.Empty: stow does not itself transition the jaws (unlike posture, which it
// does), it only requires them to already read empty throughout -- the same relation nasa/europa's own Rover
// example uses for a cross-timeline check the action does not itself cause (Instrument::TakeSample's
// `contained_by(condition object.navigator.At at)`, Rover::Go's `contained_by(condition
// object.instrument.location.Stowed)`). Using `met_by` here instead let the solver satisfy it with a token that
// was never actually connected back to the real jaws state (verified empirically: it produced a `place` with no
// preceding `pick` at all, "solved" only because the precondition was never really checked).
LunarBot::stow
{
  met_by(condition object.posture.Ready from);
  contained_by(condition object.jaws.Empty j);
  meets(effect object.posture.Stowed to);
}

// both need the base already docked at the support's work stance (dock_at_feature, standoff 0) -- the same
// precondition the covered instance actually needs (Ours/PLEXIL dock before every pick/place). Making this a
// real precondition, not an externally-dictated step, is the point of using EUROPA at all: given only the
// mission's own goals, the solver has to derive navigate_to_feature+dock_at_feature itself to satisfy it.
// `contained_by` for posture/base, the same cross-timeline reason as stow's jaws check above -- pick/place do not
// themselves move the base or change posture. `met_by` stays for jaws/item.loc: those are the same timelines
// pick/place's own effects transition, exactly like Rover::Go's `met_by(condition object.navigator.At _from)`.
LunarBot::pick
{
  contained_by(condition object.posture.Ready p);
  met_by(condition object.jaws.Empty j);
  contained_by(condition object.base.At bp);
  eq(bp.loc, support.work);
  met_by(condition item.loc.On from);
  eq(from.support, support);
  meets(effect object.jaws.Holding held);
  eq(held.item, item);
  meets(effect item.loc.Held to);
}

LunarBot::place
{
  contained_by(condition object.posture.Ready p);
  met_by(condition object.jaws.Holding held);
  eq(held.item, item);
  contained_by(condition object.base.At bp);
  eq(bp.loc, support.work);
  met_by(condition item.loc.Held from);
  meets(effect object.jaws.Empty j);
  meets(effect item.loc.On to);
  eq(to.support, support);
}

// the unit's reset button, docked at: its breaker closes. `feature` is kept as its own action parameter (not just
// read off unit.button) so it is directly readable in the activity's own parameter list, the same reason pick/place
// keep `support` alongside `item` -- constrained to actually be the unit's own button, not left for the solver to
// pick freely.
LunarBot::press
{
  eq(feature, unit.button);
  contained_by(condition object.base.At bp);
  eq(bp.loc, feature.work);
  meets(effect object.posture.Ready to);
  met_by(condition unit.panel.Faulted pf);
  meets(effect unit.panel.Restored pt);
}

// the module that is not serviceable, out of its blocked unit's bay (a tripped unit is de-energized: access Cleared)
LunarBot::remove_module
{
  eq(unit, bay.unit);
  eq(item.serviceable, false);
  contained_by(condition bay.access.Cleared a);
  contained_by(condition unit.panel.Blocked pb);
  contained_by(condition object.posture.Ready p);
  met_by(condition object.jaws.Empty j);
  contained_by(condition object.base.At bp);
  eq(bp.loc, bay.work);
  met_by(condition bay.contents.Holds h);
  eq(h.module, item);
  meets(effect object.jaws.HoldingModule held);
  eq(held.module, item);
  meets(effect bay.contents.Empty e);
}

// a serviceable module out of an energized unit whose load is non-critical, with mission control's authorization on
// record: the unit loses it and is Blocked
LunarBot::take_donor_module
{
  eq(unit, bay.unit);
  eq(unit.noncritical, true);
  eq(item.serviceable, true);
  contained_by(condition bay.access.Cleared a);
  met_by(condition unit.panel.Restored pr);
  contained_by(condition object.posture.Ready p);
  met_by(condition object.jaws.Empty j);
  contained_by(condition object.base.At bp);
  eq(bp.loc, bay.work);
  met_by(condition bay.contents.Holds h);
  eq(h.module, item);
  meets(effect object.jaws.HoldingModule held);
  eq(held.module, item);
  meets(effect bay.contents.Empty e);
  meets(effect unit.panel.Blocked pb);
}

// a serviceable module of the kind the bay takes, into the empty bay of a blocked unit: its reset can close it again
LunarBot::install_module
{
  eq(unit, bay.unit);
  eq(item.serviceable, true);
  eq(item.kind, bay.takes);
  met_by(condition unit.panel.Blocked pb);
  met_by(condition bay.contents.Empty e);
  contained_by(condition object.posture.Ready p);
  met_by(condition object.jaws.HoldingModule held);
  eq(held.module, item);
  contained_by(condition object.base.At bp);
  eq(bp.loc, bay.work);
  meets(effect object.jaws.Empty j);
  meets(effect bay.contents.Holds h);
  eq(h.module, item);
  meets(effect unit.panel.Faulted pf);
}

// a module taken out of a bay, set down on a place point nothing stands on
LunarBot::deposit_module
{
  eq(support.free, true);
  contained_by(condition object.posture.Ready p);
  met_by(condition object.jaws.HoldingModule held);
  eq(held.module, item);
  contained_by(condition object.base.At bp);
  eq(bp.loc, support.work);
  meets(effect object.jaws.Empty j);
}

// the flight-rule table grants a removal from a unit whose load is non-critical (while a crew-critical unit is down)
LunarBot::request_authorization
{
  eq(unit, bay.unit);
  eq(unit.noncritical, true);
  met_by(condition bay.access.Reserved r);
  meets(effect bay.access.Cleared c);
}
