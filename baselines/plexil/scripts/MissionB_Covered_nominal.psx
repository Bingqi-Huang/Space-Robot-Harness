<PLEXILScript>
  <Script>
    <Command name="navigate_to_feature" type="bool">
      <Param type="string">depot_stand/slot_0</Param>
      <Param type="real">1.5</Param>
      <Result>true</Result>
    </Command>
    <CommandAck name="navigate_to_feature" type="string">
      <Param type="string">depot_stand/slot_0</Param>
      <Param type="real">1.5</Param>
      <Result>COMMAND_SUCCESS</Result>
    </CommandAck>
    <Command name="dock_at_feature" type="bool">
      <Param type="string">depot_stand/slot_0</Param>
      <Param type="real">0.0</Param>
      <Param type="real">1.5</Param>
      <Result>true</Result>
    </Command>
    <CommandAck name="dock_at_feature" type="string">
      <Param type="string">depot_stand/slot_0</Param>
      <Param type="real">0.0</Param>
      <Param type="real">1.5</Param>
      <Result>COMMAND_SUCCESS</Result>
    </CommandAck>
    <Command name="arm_ready" type="bool">
      <Param type="real">0.08</Param>
      <Result>true</Result>
    </Command>
    <CommandAck name="arm_ready" type="string">
      <Param type="real">0.08</Param>
      <Result>COMMAND_SUCCESS</Result>
    </CommandAck>
    <Command name="pick" type="bool">
      <Param type="string">the spare ORU (gold MLI-covered box with a T-shaped bail/lifting eye on top) staged on the depot stand</Param>
      <Param type="string">the narrow neck of the bail handle, just below the transverse head and above the wider mounting pedestal (fingers close on opposite sides of the neck)</Param>
      <Param type="string">spare_oru</Param>
      <Result>true</Result>
    </Command>
    <CommandAck name="pick" type="string">
      <Param type="string">the spare ORU (gold MLI-covered box with a T-shaped bail/lifting eye on top) staged on the depot stand</Param>
      <Param type="string">the narrow neck of the bail handle, just below the transverse head and above the wider mounting pedestal (fingers close on opposite sides of the neck)</Param>
      <Param type="string">spare_oru</Param>
      <Result>COMMAND_SUCCESS</Result>
    </CommandAck>
    <Command name="navigate_to_feature" type="bool">
      <Param type="string">pdu_1_shelf/shelf</Param>
      <Param type="real">1.5</Param>
      <Result>true</Result>
    </Command>
    <CommandAck name="navigate_to_feature" type="string">
      <Param type="string">pdu_1_shelf/shelf</Param>
      <Param type="real">1.5</Param>
      <Result>COMMAND_SUCCESS</Result>
    </CommandAck>
    <Command name="dock_at_feature" type="bool">
      <Param type="string">pdu_1_shelf/shelf</Param>
      <Param type="real">0.0</Param>
      <Param type="real">1.5</Param>
      <Result>true</Result>
    </Command>
    <CommandAck name="dock_at_feature" type="string">
      <Param type="string">pdu_1_shelf/shelf</Param>
      <Param type="real">0.0</Param>
      <Param type="real">1.5</Param>
      <Result>COMMAND_SUCCESS</Result>
    </CommandAck>
    <Command name="place" type="bool">
      <Param type="string">pdu_1_shelf/shelf</Param>
      <Param type="string">below_overhang</Param>
      <Param type="string">spare_oru</Param>
      <Result>true</Result>
    </Command>
    <CommandAck name="place" type="string">
      <Param type="string">pdu_1_shelf/shelf</Param>
      <Param type="string">below_overhang</Param>
      <Param type="string">spare_oru</Param>
      <Result>COMMAND_SUCCESS</Result>
    </CommandAck>
    <Command name="stow" type="bool">
      <Param type="real">0.08</Param>
      <Result>true</Result>
    </Command>
    <CommandAck name="stow" type="string">
      <Param type="real">0.08</Param>
      <Result>COMMAND_SUCCESS</Result>
    </CommandAck>
    <Command name="navigate_to_pose" type="bool">
      <Param type="real">0.0</Param>
      <Param type="real">0.0</Param>
      <Param type="real">0.0</Param>
      <Result>true</Result>
    </Command>
    <CommandAck name="navigate_to_pose" type="string">
      <Param type="real">0.0</Param>
      <Param type="real">0.0</Param>
      <Param type="real">0.0</Param>
      <Result>COMMAND_SUCCESS</Result>
    </CommandAck>
  </Script>
</PLEXILScript>
