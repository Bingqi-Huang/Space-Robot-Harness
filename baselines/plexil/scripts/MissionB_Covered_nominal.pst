// MissionB_Covered nominal-path simulation (execution_plan section 11.1): every capability call the covered plan makes
// returns success, in the order MissionB_Covered.plx + the library nodes issue them (ToDepot: nav, dock; Pick:
// arm_ready, pick; ToShelf: nav, dock; Place: place; Return: stow, navigate_to_pose). No recovery branch is
// exercised here -- the recovery set is not yet written (docs/baselines/plexil.md).

script {
  command navigate_to_feature ("depot_stand/slot_0":string, 1.5:real) = true:bool;
  command-success navigate_to_feature ("depot_stand/slot_0":string, 1.5:real);

  command dock_at_feature ("depot_stand/slot_0":string, 0.0:real, 1.5:real) = true:bool;
  command-success dock_at_feature ("depot_stand/slot_0":string, 0.0:real, 1.5:real);

  command arm_ready (0.08:real) = true:bool;
  command-success arm_ready (0.08:real);

  command pick ("the spare ORU (gold MLI-covered box with a T-shaped bail/lifting eye on top) staged on the depot stand":string,
                "the narrow neck of the bail handle, just below the transverse head and above the wider mounting pedestal (fingers close on opposite sides of the neck)":string,
                "spare_oru":string, "depot_stand/slot_0":string) = true:bool;
  command-success pick ("the spare ORU (gold MLI-covered box with a T-shaped bail/lifting eye on top) staged on the depot stand":string,
                        "the narrow neck of the bail handle, just below the transverse head and above the wider mounting pedestal (fingers close on opposite sides of the neck)":string,
                        "spare_oru":string, "depot_stand/slot_0":string);

  command navigate_to_feature ("pdu_1_shelf/shelf":string, 1.5:real) = true:bool;
  command-success navigate_to_feature ("pdu_1_shelf/shelf":string, 1.5:real);

  command dock_at_feature ("pdu_1_shelf/shelf":string, 0.0:real, 1.5:real) = true:bool;
  command-success dock_at_feature ("pdu_1_shelf/shelf":string, 0.0:real, 1.5:real);

  command place ("pdu_1_shelf/shelf":string, "below_overhang":string, "spare_oru":string) = true:bool;
  command-success place ("pdu_1_shelf/shelf":string, "below_overhang":string, "spare_oru":string);

  command stow (0.08:real) = true:bool;
  command-success stow (0.08:real);

  command navigate_to_pose (0.0:real, 0.0:real, 0.0:real) = true:bool;
  command-success navigate_to_pose (0.0:real, 0.0:real, 0.0:real);
}
