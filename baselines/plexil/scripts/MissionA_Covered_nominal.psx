<PLEXILScript>
  <Script>
    <Command name="navigate_to_feature" type="bool">
      <Param type="string">pdu_2_panel/press</Param>
      <Param type="real">1.5</Param>
      <Result>true</Result>
    </Command>
    <CommandAck name="navigate_to_feature" type="string">
      <Param type="string">pdu_2_panel/press</Param>
      <Param type="real">1.5</Param>
      <Result>COMMAND_SUCCESS</Result>
    </CommandAck>
    <Command name="dock_at_feature" type="bool">
      <Param type="string">pdu_2_panel/press</Param>
      <Param type="real">0.0</Param>
      <Param type="real">1.5</Param>
      <Result>true</Result>
    </Command>
    <CommandAck name="dock_at_feature" type="string">
      <Param type="string">pdu_2_panel/press</Param>
      <Param type="real">0.0</Param>
      <Param type="real">1.5</Param>
      <Result>COMMAND_SUCCESS</Result>
    </CommandAck>
    <Command name="press" type="bool">
      <Param type="string">the round red push button set into the yellow sub-panel</Param>
      <Param type="string">pdu_2_panel/press</Param>
      <Result>true</Result>
    </Command>
    <CommandAck name="press" type="string">
      <Param type="string">the round red push button set into the yellow sub-panel</Param>
      <Param type="string">pdu_2_panel/press</Param>
      <Result>COMMAND_SUCCESS</Result>
    </CommandAck>
    <Command name="stow" type="bool">
      <Param type="real">0.08</Param>
      <Result>true</Result>
    </Command>
    <CommandAck name="stow" type="string">
      <Param type="real">0.08</Param>
      <Result>COMMAND_SUCCESS</Result>
    </CommandAck>
    <Command name="navigate_to_pose" type="bool">
      <Param type="real">0.0</Param>
      <Param type="real">0.0</Param>
      <Param type="real">0.0</Param>
      <Result>true</Result>
    </Command>
    <CommandAck name="navigate_to_pose" type="string">
      <Param type="real">0.0</Param>
      <Param type="real">0.0</Param>
      <Param type="real">0.0</Param>
      <Result>COMMAND_SUCCESS</Result>
    </CommandAck>
  </Script>
</PLEXILScript>
