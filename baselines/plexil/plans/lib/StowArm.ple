// Reusable library node: fold the arm into its travel pose before driving on to another job (jaws must already be
// empty -- contracts.yaml `stow`: "Fold the arm into its travel pose for driving ... put a held item down first").
// StowAndReturn's Stow leg, without the drive to the dock.
//
// Result comes back through `ok` (InOut); see lib/DriveAndDock.ple for why not node outcome.
//
// Failure handling: at most 3 identical attempts (Try; docs/baselines/authoring_spec.md tier 1).

Boolean Command stow(Real);

StowArm:
{
  InOut Boolean ok;

  Stow: Try
  {
    PreCondition ok;
    Stow1: { EndCondition isKnown(ok); PostCondition ok; ok = stow(0.08); }
    Stow2: { EndCondition isKnown(ok); PostCondition ok; ok = stow(0.08); }
    Stow3: { EndCondition isKnown(ok); PostCondition ok; ok = stow(0.08); }
  }
}
