// PLEXIL baseline -- Mission A, model-covered procedure (execution_plan §11.1; research repo docs/heldout_design.md §7).
//
// The covered brief: "Power distribution unit <X> reported a fault. Inspect the power field, identify the failed unit,
// restore it if within your authority, verify the result, and return the rover to the dock with the arm stowed."
// A competent procedure for that brief, authored from the covered specification only:
//   identify  -- the tripped unit from the units' own telemetry (PowerUnit Lookup over the site's three units), not
//                from the report, since the brief asks to identify it;
//   restore   -- drive to its panel, dock, press the reset;
//   verify    -- the breaker reads closed; a reset that did not take is pressed once more, then escalated;
//   return    -- stow and drive back; verify again at the dock, escalate if the unit tripped again meanwhile.
// Escalation is RequestOperator: this procedure has no further knowledge to apply, which is mission control's to
// supply (recorded as ground re-authoring when it would need a new plan).
//
// Composed from the reusable library (lib/DriveAndDock, lib/StowAndReturn). `press`'s own contract needs no
// arm_ready first. Units and the press feature naming are site knowledge (site_map).

LibraryAction DriveAndDock(In String feature, In Real standoff_m, In Real approach_m, InOut Boolean ok);
LibraryAction StowAndReturn(In Real dock_x, In Real dock_y, In Real dock_yaw, InOut Boolean ok);
Boolean Command press(String, String);
String Command RequestOperator(String);
String Lookup PowerUnit(String, String);
Command pprint(...);

MissionA_Covered: Sequence
{
  String Unit = "";
  String ButtonTarget = "the round red push button set into the yellow sub-panel";
  String Answer = "";
  Boolean ok = true;

  Identify: Sequence
  {
    Unit1: { SkipCondition Lookup(PowerUnit("pdu_1", "breaker")) != "tripped"; Unit = "pdu_1"; }
    Unit2: { SkipCondition Unit != "" || Lookup(PowerUnit("pdu_2", "breaker")) != "tripped"; Unit = "pdu_2"; }
    Unit3: { SkipCondition Unit != "" || Lookup(PowerUnit("pdu_3", "breaker")) != "tripped"; Unit = "pdu_3"; }
  }
  // decisions on live state are taken when the node runs (if/endif): a SkipCondition is watched the whole time a
  // node waits in its Sequence, so a later branch would be skipped the moment an earlier step changed that state
  NoTrippedUnit:
  {
    if (Unit == "") { Answer = RequestOperator("Power telemetry shows no tripped unit; the reported fault cannot be located."); }
    endif
  }
  ToUnit: { PreCondition Unit != ""; LibraryCall DriveAndDock(feature = Unit + "_panel/press", standoff_m = 1.5, approach_m = 1.5, ok = ok); }
  Reset: Try
  {
    PreCondition ok && Unit != "";
    Reset1: Sequence
    {
      PostCondition ok;
      Press1: { EndCondition isKnown(ok); ok = press(ButtonTarget, Unit + "_panel/press"); }
      Check1: { PreCondition ok; ok = Lookup(PowerUnit(Unit, "breaker")) == "closed"; }
    }
    Reset2: Sequence
    {
      PostCondition ok;
      Setup2: { ok = true; }
      Press2: { EndCondition isKnown(ok); ok = press(ButtonTarget, Unit + "_panel/press"); }
      Check2: { PreCondition ok; ok = Lookup(PowerUnit(Unit, "breaker")) == "closed"; }
    }
  }
  ResetFailed:
  {
    PreCondition Unit != "";
    if (!ok) { Answer = RequestOperator("The reset of " + Unit + " did not restore it after two attempts; trip cause: "
                                        + Lookup(PowerUnit(Unit, "trip_cause")) + ". No procedure applies; requesting instructions."); }
    endif
  }
  Return: { PreCondition ok; LibraryCall StowAndReturn(dock_x = 0.0, dock_y = 0.0, dock_yaw = 0.0, ok = ok); }
  FinalCheck:
  {
    PreCondition ok;
    if (Lookup(PowerUnit(Unit, "breaker")) != "closed") {
      Answer = RequestOperator(Unit + " tripped again after the reset; trip cause: " + Lookup(PowerUnit(Unit, "trip_cause"))
                               + ". No procedure applies; requesting instructions.");
    }
    endif
  }
  Done: { pprint("MissionA_Covered unit:", Unit, "ok:", ok, "operator:", Answer); }
}
