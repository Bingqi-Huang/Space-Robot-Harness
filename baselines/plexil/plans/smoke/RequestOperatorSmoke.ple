// Offline smoke plan for the RequestOperator Command (execution_plan §13.2, operator mechanism only -- no
// mission logic). Verified against the operator console in scripted-answer mode; never the simulation.
// Compile: plexilc RequestOperatorSmoke.ple
// Run:     universalExec -c ../../interface-config.xml -p RequestOperatorSmoke.plx   (ROS_DOMAIN_ID=95)

String Command RequestOperator(String);
Command pprint(...);

RequestOperatorSmoke: Sequence
{
  String Answer;
  Ask: { EndCondition isKnown(Answer); Answer = RequestOperator("offline adapter smoke test: reply with any text"); }
  Report: { pprint("operator answered:", Answer); }
}
